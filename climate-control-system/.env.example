NODE_ENV=development
FRONTEND_PORT=5173
BACKEND_PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# Database (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=climate_user
MYSQL_PASSWORD=climate_password
MYSQL_DATABASE=climate_control

# JWT
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Realtime
SOCKET_CORS_ORIGIN=http://localhost:5173

# Optional MQTT
MQTT_ENABLED=true
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=climate_mqtt
MQTT_PASSWORD=climate_mqtt_password
MQTT_SENSOR_TOPIC=climate/sensor/data
MQTT_DEVICE_CONTROL_TOPIC_PREFIX=climate/device/control

# Comma-separated device API keys for ESP32 ingress
DEVICE_API_KEYS=replace_me_device_key_1,replace_me_device_key_2
